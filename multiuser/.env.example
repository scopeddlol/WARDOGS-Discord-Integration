# Your reverse proxy must share this existing Docker network.
PROXY_NETWORK=proxy
# Choose a unique random secret of at least 32 characters. Never share it with agents.
CONTROLLER_ADMIN_TOKEN=CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Only the controller needs the Discord bot credentials.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
PUBLISH_INTERVAL_SECONDS=15
AGENT_TIMEOUT_SECONDS=90
# Keep disabled for normal use. This is only for local/CI tests without Discord.
DISCORD_DRY_RUN=0
